<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relative_splash_love2d"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sh_background">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/splash_card"
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:cardBackgroundColor="@color/sh_primary_container"
            app:cardCornerRadius="32dp"
            app:cardElevation="10dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/splash_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/splash_love2d"
                android:contentDescription="@string/app_logo_desc" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="قهرمان سایه ای"
            android:textColor="@color/sh_on_background"
            android:textSize="26sp"
            android:textStyle="bold"
            android:alpha="0" />

        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="SandS Programming Group"
            android:textColor="@color/sh_on_surface_variant"
            android:textSize="13sp"
            android:alpha="0" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:indeterminate="true"
            app:indicatorColor="@color/sh_primary"
            app:trackColor="@color/sh_surface_variant"
            app:trackCornerRadius="3dp"
            app:trackThickness="5dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:text="ساخته شده با موتور LÖVE 2D"
        android:textColor="@color/sh_outline"
        android:textSize="11sp" />
</FrameLayout>
